datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  password_hash String
  role          String     // Admin, Analyst, Field Officer
  created_at    DateTime   @default(now())
}

model Incident {
  id          String   @id @default(uuid())
  type        String
  severity    Int
  lat         Float
  lng         Float
  zone_id     String
  status      String   // open, closed, under investigation
  description String
  reported_by String
  photo_urls  String[] @default([]) // Array of paths to evidence photos
  timestamp   DateTime @default(now())
}

model CitizenReport {
  id           String   @id @default(uuid())
  tracking_id  String   @unique // CR-2024-XXXXX
  name         String?
  phone        String?
  location     String
  type         String
  description  String
  photo_url    String?
  status       String   @default("pending") // pending, approved, rejected
  created_at   DateTime @default(now())
}

model UserPreference {
  id              String   @id @default(uuid())
  user_id         String   @unique
  watched_zones   String[] @default([])
  crime_types     String[] @default([])
  min_anomaly_score Float  @default(0.5)
}

model Zone {
  id               String @id @default(uuid())
  name             String
  boundary_geojson String // Storing as JSON string
  population       Int
  risk_score       Int    @default(0)
}

model Alert {
  id              String    @id @default(uuid())
  zone_id         String
  score           Float
  crime_type      String
  triggered_at    DateTime  @default(now())
  acknowledged_by String?
  acknowledged_at DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  user_id      String
  action       String
  target_table String
  target_id    String
  timestamp    DateTime @default(now())
}
